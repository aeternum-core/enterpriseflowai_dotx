# EnterpriseFlow AI Configuration

# Environment
ENVIRONMENT=development
PROJECT_NAME=EnterpriseFlow AI
SECRET_KEY=enterpriseflow-ai-super-secure-production-key-2026

# Database
# Default: SQLite (Instant standalone local zero-dependency run)
DATABASE_URL=sqlite:///./enterpriseflow.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/enterpriseflow

# LLM Provider Configuration (Optional - Deterministic fallback active by default)
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.5-flash

# Tool Gateway & Policy Engine
ENFORCE_STRICT_RBAC=true
CHAOS_TESTING_ENABLED=true

